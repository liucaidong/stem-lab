{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-ingestion-session/v1alpha1",
  "title": "Package Ingestion Session Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "session_id",
    "package_id",
    "package_version",
    "status",
    "revision",
    "attempt_count",
    "created_at",
    "updated_at",
    "expires_at",
    "transitions",
    "validation_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1alpha1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "created",
        "receiving",
        "received",
        "quarantined",
        "validating",
        "validated",
        "rejected",
        "revoked",
        "expired"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "validation_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "terminal_reason_code": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "from_state",
        "to_state",
        "command_id",
        "idempotency_key",
        "request_digest",
        "actor_id",
        "occurred_at",
        "expected_revision",
        "resulting_revision"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "from_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "created",
            "receiving",
            "received",
            "quarantined",
            "validating",
            "validated",
            "rejected",
            "revoked",
            "expired"
          ]
        },
        "to_state": {
          "enum": [
            "created",
            "receiving",
            "received",
            "quarantined",
            "validating",
            "validated",
            "rejected",
            "revoked",
            "expired"
          ]
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "resulting_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_digest",
        "catalog_snapshot_digest",
        "archive_digest",
        "resource_count",
        "verified_resource_count"
      ],
      "properties": {
        "source_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "catalog_snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "archive_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "resource_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_resource_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
