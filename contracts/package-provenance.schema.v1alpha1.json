{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-provenance/v1alpha1",
  "title": "Package Provenance Predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicate_version",
    "builder_id",
    "build_type",
    "source",
    "materials",
    "build_started_at",
    "build_finished_at"
  ],
  "properties": {
    "predicate_version": {
      "const": "1alpha1"
    },
    "builder_id": {
      "type": "string",
      "minLength": 1
    },
    "build_type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "digest"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "build_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "build_finished_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
