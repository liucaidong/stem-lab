{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/scientific-expression-ast/v1alpha1",
  "title": "Scientific Expression AST v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expression_id",
    "ast_version",
    "root",
    "expected_type",
    "language_id"
  ],
  "properties": {
    "expression_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "ast_version": {
      "const": "1alpha1"
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "expected_type": {
      "$ref": "#/$defs/quantity_type"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "language_id": {
      "const": "stemlab-expression-ast/v1"
    }
  },
  "$defs": {
    "quantity_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity_kind",
        "dimension"
      ],
      "properties": {
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": -32,
            "maximum": 32
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/constant"
        },
        {
          "$ref": "#/$defs/symbol"
        },
        {
          "$ref": "#/$defs/unary"
        },
        {
          "$ref": "#/$defs/binary"
        },
        {
          "$ref": "#/$defs/call"
        }
      ]
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit_id",
        "quantity_kind"
      ],
      "properties": {
        "kind": {
          "const": "constant"
        },
        "value": {
          "type": "number"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id"
      ],
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "symbol_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "operand"
      ],
      "properties": {
        "kind": {
          "const": "unary"
        },
        "operator": {
          "enum": [
            "negate",
            "positive"
          ]
        },
        "operand": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "binary"
        },
        "operator": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "power"
          ]
        },
        "left": {
          "$ref": "#/$defs/node"
        },
        "right": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "arguments"
      ],
      "properties": {
        "kind": {
          "const": "call"
        },
        "function": {
          "enum": [
            "abs",
            "sqrt",
            "exp",
            "log",
            "sin",
            "cos"
          ]
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
