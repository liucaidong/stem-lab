{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/worker-job-lease/v2alpha1",
  "title": "Worker Job Lease v2alpha1",
  "description": "Versioned reference lease carrying the persisted Session binding. Not a production lease protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "job_id",
    "session_id",
    "owner",
    "epoch",
    "expires_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
