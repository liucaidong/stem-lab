{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-ingestion-policy/v1alpha1",
  "title": "Package Archive Ingestion Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "max_archive_bytes",
    "max_entries",
    "max_entry_bytes",
    "max_total_uncompressed_bytes",
    "max_compression_ratio",
    "allowed_compression_methods",
    "require_manifest_at_root",
    "reject_symlinks",
    "reject_encrypted",
    "allow_casefold_collisions"
  ],
  "properties": {
    "policy_version": {
      "const": "1alpha1"
    },
    "max_archive_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "max_entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_entry_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "max_total_uncompressed_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "max_compression_ratio": {
      "type": "number",
      "exclusiveMinimum": 1,
      "maximum": 10000
    },
    "allowed_compression_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "stored",
          "deflated"
        ]
      }
    },
    "require_manifest_at_root": {
      "const": true
    },
    "reject_symlinks": {
      "const": true
    },
    "reject_encrypted": {
      "const": true
    },
    "allow_casefold_collisions": {
      "const": false
    }
  }
}
