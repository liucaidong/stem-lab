{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/engineering-integration-audit/v1alpha1",
  "title": "Engineering Integration Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "audit_date",
    "result",
    "scope",
    "checks",
    "findings",
    "readiness"
  ],
  "properties": {
    "report_version": {
      "const": "1alpha1"
    },
    "audit_date": {
      "type": "string",
      "format": "date"
    },
    "result": {
      "enum": [
        "PASS",
        "CONDITIONAL_NOT_READY",
        "FAIL"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "PARTIAL",
              "OPEN"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "risk",
          "status",
          "title",
          "impact",
          "required_action"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "MITIGATED",
              "ACCEPTED_RISK"
            ]
          },
          "title": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_code_freeze",
        "production_ready",
        "architecture_contract_coverage",
        "next_gate"
      ],
      "properties": {
        "product_code_freeze": {
          "const": true
        },
        "production_ready": {
          "const": false
        },
        "architecture_contract_coverage": {
          "enum": [
            "PARTIAL",
            "SUBSTANTIAL",
            "COMPLETE"
          ]
        },
        "next_gate": {
          "type": "string"
        }
      }
    }
  }
}
