{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-canonical-manifest/v1alpha1",
  "title": "Package Canonical Manifest Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_version",
    "package",
    "content",
    "resources",
    "dependency_closure"
  ],
  "properties": {
    "projection_version": {
      "const": "1alpha1"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "package_id",
        "package_version"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "resource_type",
          "resource_id",
          "version",
          "media_type",
          "size_bytes",
          "digest",
          "license_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "resource_type": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "license_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependency_closure": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "resource_id",
          "version",
          "digest"
        ],
        "properties": {
          "resource_type": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
