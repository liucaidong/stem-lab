{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-resource-catalog-snapshot/v1alpha1",
  "title": "Package Resource Catalog Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "snapshot_id",
    "policy",
    "resources"
  ],
  "properties": {
    "catalog_version": {
      "const": "1alpha1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_host_allowlist",
        "allow_restricted_references"
      ],
      "properties": {
        "external_host_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_restricted_references": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id",
        "version",
        "digest"
      ],
      "properties": {
        "resource_type": {
          "enum": [
            "model",
            "scene",
            "instrument",
            "workflow",
            "rubric",
            "asset",
            "dataset",
            "solver-profile",
            "expression",
            "other"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relation"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "relation": {
          "enum": [
            "requires",
            "embeds",
            "uses",
            "references"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "storage",
        "uri",
        "media_type",
        "size_bytes",
        "license_id",
        "dependencies"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "storage": {
          "enum": [
            "embedded",
            "external",
            "restricted"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "access_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    }
  }
}
