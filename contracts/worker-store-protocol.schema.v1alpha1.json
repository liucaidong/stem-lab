{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/worker-store-protocol/v1alpha1",
  "title": "Worker Store Protocol",
  "description": "Driver-neutral request, response and error contracts. Tenant identity is carried only by an opaque trusted access assertion, never by an untrusted payload selector.",
  "$defs": {
    "StoreAccessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion", "audience"],
      "properties": {
        "assertion": {"type": "string", "minLength": 1, "maxLength": 8192},
        "audience": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "JobLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "job_id", "owner", "epoch", "expires_at"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "epoch": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "ClaimCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "worker_id", "supported_job_types", "lease_seconds", "max_items"],
      "properties": {
        "operation": {"const": "claim"},
        "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "supported_job_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "lease_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "max_items": {"const": 1}
      }
    },
    "RenewCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "lease", "lease_seconds"],
      "properties": {
        "operation": {"const": "renew"},
        "lease": {"$ref": "#/$defs/JobLease"},
        "lease_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
      }
    },
    "CompleteCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "lease", "expected_session_revision", "result_ref", "idempotency_key", "request_digest"],
      "properties": {
        "operation": {"const": "complete"},
        "lease": {"$ref": "#/$defs/JobLease"},
        "expected_session_revision": {"type": "integer", "minimum": 0},
        "result_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "FailCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "lease", "error_code", "safe_message", "retryable", "retry_delay_seconds", "idempotency_key"],
      "properties": {
        "operation": {"const": "fail"},
        "lease": {"$ref": "#/$defs/JobLease"},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "safe_message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"},
        "retry_delay_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "StoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "access_context", "command"],
      "properties": {
        "schema_version": {"const": "1alpha1"},
        "access_context": {"$ref": "#/$defs/StoreAccessContext"},
        "command": {
          "oneOf": [
            {"$ref": "#/$defs/ClaimCommand"},
            {"$ref": "#/$defs/RenewCommand"},
            {"$ref": "#/$defs/CompleteCommand"},
            {"$ref": "#/$defs/FailCommand"}
          ]
        }
      }
    },
    "ClaimedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease", "job_type", "payload", "attempt_count"],
      "properties": {
        "lease": {"$ref": "#/$defs/JobLease"},
        "job_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "payload": {"type": "object"},
        "attempt_count": {"type": "integer", "minimum": 1}
      }
    },
    "StoreOutcome": {
      "enum": ["APPLIED", "DUPLICATE", "STALE", "EXPIRED", "RETRY_SCHEDULED", "DEAD_LETTERED"]
    },
    "StoreResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome", "result"],
      "properties": {
        "schema_version": {"const": "1alpha1"},
        "outcome": {"$ref": "#/$defs/StoreOutcome"},
        "result": {
          "oneOf": [
            {"$ref": "#/$defs/ClaimedJob"},
            {"type": "null"}
          ]
        }
      }
    },
    "StoreError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error_code", "safe_message", "retryable", "outcome_known"],
      "properties": {
        "schema_version": {"const": "1alpha1"},
        "error_code": {
          "enum": [
            "TENANT_ACCESS_DENIED",
            "JOB_NOT_FOUND",
            "LEASE_STALE",
            "LEASE_EXPIRED",
            "SESSION_REVISION_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "POOL_ACQUIRE_TIMEOUT",
            "TRANSIENT_DATABASE_FAILURE",
            "PERMANENT_DATABASE_FAILURE",
            "TRANSACTION_OUTCOME_UNKNOWN",
            "SCHEMA_VERSION_UNSUPPORTED",
            "INVARIANT_VIOLATION"
          ]
        },
        "safe_message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"},
        "outcome_known": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"error_code": {"const": "TRANSACTION_OUTCOME_UNKNOWN"}}, "required": ["error_code"]},
          "then": {"properties": {"outcome_known": {"const": false}}}
        },
        {
          "if": {"properties": {"error_code": {"not": {"const": "TRANSACTION_OUTCOME_UNKNOWN"}}}, "required": ["error_code"]},
          "then": {"properties": {"outcome_known": {"const": true}}}
        }
      ]
    }
  },
  "$ref": "#/$defs/StoreRequest"
}
