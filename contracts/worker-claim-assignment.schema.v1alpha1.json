{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/worker-claim-assignment/v1alpha1",
  "title": "Worker Claim Assignment Capability v1alpha1",
  "description": "Tenant-neutral capability authorizing one queue claim through a persisted worker assignment. It intentionally contains no tenant_id or job_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "kid",
    "sub",
    "aud",
    "action",
    "assignment_id",
    "job_types",
    "iat",
    "exp",
    "nonce"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "aud": {
      "const": "stemlab-worker-claim"
    },
    "action": {
      "const": "worker.job.claim"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "job_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "$comment": "Database reference additionally checks exp > iat, maximum token lifetime, Ed25519 signature, key lifecycle, assignment identity, and that job_types is a subset of the persisted assignment allowlist."
}
