{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-attestation/v1alpha1",
  "title": "Package Attestation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "package_subject",
    "predicate_type",
    "predicate",
    "signatures"
  ],
  "properties": {
    "envelope_version": {
      "const": "1alpha1"
    },
    "package_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_version",
        "digest_profile",
        "digest"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "digest_profile": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "predicate_type": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "signer_identity",
          "algorithm",
          "signature_value",
          "signed_at"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "signer_identity": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "enum": [
              "ed25519",
              "ecdsa-p256-sha256",
              "rsa-pss-sha256"
            ]
          },
          "signature_value": {
            "type": "string",
            "minLength": 16
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
