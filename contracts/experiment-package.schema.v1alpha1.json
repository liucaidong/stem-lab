{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/experiment-package/v1alpha1",
  "title": "ExperimentPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "stemlab.example/v1alpha1" },
    "kind": { "const": "ExperimentPackage" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "subject"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 200, "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 4000 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gradeBand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 },
            "max": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learningObjectives", "model", "scene", "instruments", "workflow", "assessment", "runtime", "assets", "validation"],
      "properties": {
        "learningObjectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "model": { "$ref": "#/$defs/resourceRef" },
        "scene": { "$ref": "#/$defs/resourceRef" },
        "instruments": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceRef" }
        },
        "workflow": { "$ref": "#/$defs/resourceRef" },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rubric"],
          "properties": { "rubric": { "$ref": "#/$defs/resourceRef" } }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedModes", "resetPolicy", "requiredCapabilities"],
          "properties": {
            "allowedModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["algebraic", "ode", "discrete-event"] }
            },
            "resetPolicy": { "enum": ["restore-initial-state", "create-new-attempt"] },
            "requiredCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mediaType", "digest", "licenseId", "source"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "mediaType": { "type": "string", "minLength": 1 },
              "sizeBytes": { "type": "integer", "minimum": 0 },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "licenseId": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validationSuite", "expertReviewRequired"],
          "properties": {
            "validationSuite": { "type": "string", "minLength": 1 },
            "expertReviewRequired": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
