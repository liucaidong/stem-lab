{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/worker-retry-policy/v1alpha1",
  "title": "Worker Retry Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_policy",
    "policies",
    "policy_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1alpha1"
    },
    "default_policy": {
      "$ref": "#/$defs/policy"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_code",
        "retryable",
        "base_delay_micros",
        "max_delay_micros",
        "safe_message"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "retryable": {
          "type": "boolean"
        },
        "safe_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "base_delay_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000000
        },
        "max_delay_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retryable": {
                "const": false
              }
            },
            "required": [
              "retryable"
            ]
          },
          "then": {
            "properties": {
              "base_delay_micros": {
                "const": 0
              },
              "max_delay_micros": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
