{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/unit-registry/v1",
  "title": "STEM Lab Unit Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "dimension_order", "units"],
  "properties": {
    "registry_version": { "const": "1.0-draft" },
    "dimension_order": {
      "const": ["mass", "length", "time", "electric_current"]
    },
    "units": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id", "symbol", "name", "quantity_kinds",
          "dimension", "scale_to_si", "offset_to_si"
        ],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "quantity_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "dimension": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer" }
          },
          "scale_to_si": { "type": "number", "exclusiveMinimum": 0 },
          "offset_to_si": { "type": "number" }
        }
      }
    }
  }
}
