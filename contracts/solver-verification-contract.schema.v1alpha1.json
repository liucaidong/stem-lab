{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/solver-verification-contract/v1alpha1",
  "title": "Scientific Solver Verification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "solver_profile",
    "numeric_policy",
    "ode_contract",
    "reference_case_ids"
  ],
  "properties": {
    "contract_version": {
      "const": "1alpha1"
    },
    "solver_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_id",
        "version",
        "numeric_format",
        "deterministic",
        "supported_methods"
      ],
      "properties": {
        "solver_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "numeric_format": {
          "enum": [
            "float32",
            "float64",
            "decimal",
            "fixed-point"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "supported_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "forward-euler",
              "rk4",
              "adaptive-rk",
              "implicit-ode",
              "algebraic"
            ]
          }
        }
      }
    },
    "numeric_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_tolerance",
        "relative_tolerance",
        "max_steps",
        "min_step",
        "max_step",
        "non_finite_policy",
        "overflow_policy"
      ],
      "properties": {
        "absolute_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "min_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "non_finite_policy": {
          "const": "fail-execution"
        },
        "overflow_policy": {
          "const": "fail-execution"
        }
      }
    },
    "ode_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_representation",
        "time_unit_required",
        "error_estimation",
        "step_control"
      ],
      "properties": {
        "state_representation": {
          "enum": [
            "vector-float64",
            "typed-quantity-vector"
          ]
        },
        "time_unit_required": {
          "type": "boolean"
        },
        "error_estimation": {
          "enum": [
            "none",
            "embedded-pair",
            "step-doubling",
            "residual-based"
          ]
        },
        "step_control": {
          "enum": [
            "fixed",
            "adaptive"
          ]
        }
      }
    },
    "reference_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
