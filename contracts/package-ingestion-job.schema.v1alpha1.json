{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-ingestion-job/v1alpha1",
  "title": "Package Ingestion Worker Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "job_id",
    "session_id",
    "package_id",
    "package_version",
    "job_type",
    "status",
    "priority",
    "attempt_count",
    "maximum_attempts",
    "available_at",
    "lease_epoch",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1alpha1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "retry",
        "succeeded",
        "dead_lettered",
        "cancelled"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "last_error_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "last_error_safe_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "lease_owner",
          "lease_expires_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at"
        ]
      }
    }
  ]
}
