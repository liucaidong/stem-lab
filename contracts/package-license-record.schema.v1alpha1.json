{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/package-license-record/v1alpha1",
  "title": "Package License Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "asset_id",
    "asset_digest",
    "license_expression",
    "source",
    "rights_assertions",
    "evidence_ref",
    "review"
  ],
  "properties": {
    "record_version": {
      "const": "1alpha1"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "license_expression": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "author_or_supplier"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "author_or_supplier": {
          "type": "string",
          "minLength": 1
        },
        "copyright_notice": {
          "type": "string"
        },
        "modified": {
          "type": "boolean"
        }
      }
    },
    "rights_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercial_use",
        "redistribution",
        "modification",
        "attribution_required"
      ],
      "properties": {
        "commercial_use": {
          "type": "boolean"
        },
        "redistribution": {
          "type": "boolean"
        },
        "modification": {
          "type": "boolean"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution_text": {
          "type": "string"
        }
      }
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string"
        },
        "exception_id": {
          "type": "string"
        }
      }
    }
  }
}
