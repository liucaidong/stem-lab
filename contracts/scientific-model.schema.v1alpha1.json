{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/scientific-model/v1alpha1",
  "title": "ScientificModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "stemlab.example/v1alpha1"
    },
    "kind": {
      "const": "ScientificModel"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "domain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKind",
        "expressionLanguage",
        "parameters",
        "variables",
        "equations",
        "constraints",
        "initialConditions",
        "validityDomain",
        "solverRequirements",
        "validationCases",
        "provenance"
      ],
      "properties": {
        "modelKind": {
          "enum": [
            "algebraic",
            "ode",
            "discrete-event"
          ]
        },
        "expressionLanguage": {
          "const": "stemlab-expression-ast/v1"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantityDefinition"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableDefinition"
          }
        },
        "equations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/equationDefinition"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraintDefinition"
          }
        },
        "initialConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initialCondition"
          }
        },
        "validityDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assumptions",
            "exclusions"
          ],
          "properties": {
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "solverRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supportedModes",
            "requiredCapabilities"
          ],
          "properties": {
            "supportedModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "algebraic",
                  "ode",
                  "discrete-event"
                ]
              }
            },
            "requiredCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "numericProfile": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validationCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resourceRef"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "reviewStatus",
            "expertReviewRequired"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reviewStatus": {
              "enum": [
                "draft",
                "in-review",
                "approved",
                "rejected"
              ]
            },
            "expertReviewRequired": {
              "type": "boolean"
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reviewerRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "quantityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol",
        "quantityKind",
        "unit",
        "defaultValue"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "quantityKind": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "defaultValue": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "variableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol",
        "quantityKind",
        "unit",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "quantityKind": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "input",
            "state",
            "output",
            "derived"
          ]
        },
        "defaultValue": {
          "type": "number"
        }
      }
    },
    "equationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "outputs",
        "expressionRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expressionRef": {
          "$ref": "#/$defs/resourceRef"
        }
      }
    },
    "constraintDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "constraintType",
        "targetIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "constraintType": {
          "enum": [
            "positive",
            "non-negative",
            "range",
            "conservation",
            "monotonic"
          ]
        },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expressionRef": {
          "$ref": "#/$defs/resourceRef"
        }
      }
    },
    "initialCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variableId",
        "value",
        "unit"
      ],
      "properties": {
        "variableId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
