{
  "fixture_version": "1alpha1",
  "policy": {
    "policy_version": "1alpha1",
    "max_archive_bytes": 1048576,
    "max_entries": 16,
    "max_entry_bytes": 262144,
    "max_total_uncompressed_bytes": 524288,
    "max_compression_ratio": 50,
    "allowed_compression_methods": [
      "stored",
      "deflated"
    ],
    "require_manifest_at_root": true,
    "reject_symlinks": true,
    "reject_encrypted": true,
    "allow_casefold_collisions": false
  },
  "negative_cases": [
    "path-traversal",
    "absolute-path",
    "backslash-path",
    "duplicate-path",
    "casefold-collision",
    "symlink-entry",
    "compression-ratio",
    "entry-count",
    "oversized-entry",
    "missing-manifest",
    "undeclared-entry",
    "resource-digest-mismatch",
    "unsupported-compression"
  ]
}
