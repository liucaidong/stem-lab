{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/events/session-started/v1",
  "title": "SessionStartedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "input_state_version",
    "epoch",
    "fencing_token",
    "solver_id",
    "solver_version",
    "package_digest"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "input_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "solver_id": {
      "type": "string",
      "minLength": 1
    },
    "solver_version": {
      "type": "string",
      "minLength": 1
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
