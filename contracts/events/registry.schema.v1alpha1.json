{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/runtime-event-registry/v1alpha1",
  "title": "Runtime Event Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "events"
  ],
  "properties": {
    "registry_version": {
      "const": "1alpha1"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "schema_version",
          "payload_schema",
          "fixture",
          "lifecycle",
          "compatibility",
          "producer_ids",
          "consumer_ids",
          "ordering_scope",
          "replay_policy",
          "retention_days",
          "data_classification",
          "poison_policy"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{1,127}$"
          },
          "schema_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "payload_schema": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "proposed",
              "active",
              "deprecated",
              "retired"
            ]
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "change_class",
              "compatible_with"
            ],
            "properties": {
              "change_class": {
                "enum": [
                  "initial",
                  "additive",
                  "breaking"
                ]
              },
              "compatible_with": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                }
              }
            }
          },
          "producer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ordering_scope": {
            "enum": [
              "aggregate",
              "unordered"
            ]
          },
          "replay_policy": {
            "enum": [
              "allowed",
              "forbidden",
              "requires-approval"
            ]
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36500
          },
          "data_classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "poison_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_attempts",
              "retry_strategy",
              "dlq_required"
            ],
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "retry_strategy": {
                "enum": [
                  "none",
                  "fixed",
                  "exponential"
                ]
              },
              "dlq_required": {
                "type": "boolean"
              }
            }
          },
          "deprecated_at": {
            "type": "string",
            "format": "date-time"
          },
          "sunset_at": {
            "type": "string",
            "format": "date-time"
          },
          "replacement_event": {
            "type": "string"
          }
        }
      }
    }
  }
}
