{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/stem-lab/observation/v1alpha1",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "data"
  ],
  "properties": {
    "apiVersion": {
      "const": "stemlab.example/v1alpha1"
    },
    "kind": {
      "const": "Observation"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "tenantId",
        "sessionId",
        "quantityId",
        "unit",
        "simulationTime",
        "simulationTimeUnit",
        "observedAt",
        "source",
        "qualityStatus",
        "stateVersion",
        "schemaVersion",
        "createdAt"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "executionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "quantityId": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Use explicit dimensionless when the quantity has no physical unit."
        },
        "simulationTime": {
          "type": "number",
          "minimum": 0
        },
        "simulationTimeUnit": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "instrument",
                "model",
                "derived",
                "imported"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "qualityStatus": {
          "enum": [
            "valid",
            "estimated",
            "invalid",
            "out-of-range"
          ]
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standardUncertainty",
            "unit"
          ],
          "properties": {
            "standardUncertainty": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "confidenceLevel": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "valueRef"
            ]
          }
        },
        {
          "required": [
            "valueRef"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "valueRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "digest",
            "sizeBytes"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
